[Unit]
After=hosting-broker.service
Requires=hosting-broker.service

[Container]
Image=localhost/monstertacle-hosting-mcp-host:local
Network=hosting-private.network
Network=hosting-outbound.network
EnvironmentFile=%h/.config/monstertacle-hosting/edge.env
Environment=Kestrel__Endpoints__Edge__Url=https://+:8443
Environment=Kestrel__Endpoints__Edge__Certificate__Path=/run/hosting/server.pfx
Environment=Mcp__BrokerUrl=https://broker:8443
Environment=Mcp__BrokerClientCertificateFile=/run/hosting/client.pfx
Environment=Mcp__PolicyFile=/run/hosting/policy.json
Volume=%h/.config/monstertacle-hosting/edge:/run/hosting:ro,Z
PublishPort=127.0.0.1:8443:8443
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
