[Unit]
After=hosting-broker.service
Requires=hosting-broker.service

[Container]
Image=localhost/monstertacle-hosting-worker-host:local
Network=hosting-private.network
EnvironmentFile=%h/.config/monstertacle-hosting/worker.env
Environment=ASPNETCORE_URLS=http://+:8080
Environment=Worker__BrokerUrl=https://broker:8443
Environment=Worker__BrokerClientCertificateFile=/run/hosting/client.pfx
Environment=Worker__StateDirectory=/var/lib/hosting/runtime
Environment=Worker__Runtime=deterministic
Volume=%h/.config/monstertacle-hosting/worker:/run/hosting:ro,Z
Volume=hosting-worker-state.volume:/var/lib/hosting:U
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
