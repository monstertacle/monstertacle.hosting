[Container]
Image=localhost/monstertacle-hosting-control-plane:local
Network=hosting-private.network
Network=hosting-outbound.network
NetworkAlias=broker
EnvironmentFile=%h/.config/monstertacle-hosting/broker.env
Environment=Kestrel__Endpoints__Broker__Url=https://+:8443
Environment=Kestrel__Endpoints__Broker__Certificate__Path=/run/hosting/server.pfx
Environment=Broker__DatabaseFile=/var/lib/hosting/broker.db
Environment=Broker__PolicyFile=/run/hosting/policy.json
Volume=%h/.config/monstertacle-hosting/broker:/run/hosting:ro,Z
Volume=hosting-broker-state.volume:/var/lib/hosting:U
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
